{
  "mcpServers": {
    "fly-official": {
      "type": "streamable-http",
      "url": "https://mcp.fly.io",
      "headers": {},
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            }
          }
        }
      }
    },
    "qumi-fly-cli": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/server/index.mjs"
      ],
      "env": {},
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
